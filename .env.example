# Supabase: Project Settings -> API
# Base project URL only, e.g. https://<project-ref>.supabase.co (no /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=
# anon or publishable key. Never put the service_role/secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public demo login (visible in the browser by design; never reuse a real password)
NEXT_PUBLIC_DEMO_EMAIL=demo@duolingo-clone.test
NEXT_PUBLIC_DEMO_PASSWORD=
